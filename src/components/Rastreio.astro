---
/**
 * Rastreio de leads. Carregado no <head> (Base.astro), antes de qualquer
 * formulário ou botão: define window.sr com canal, código S-XXXX, telefone,
 * evento (dataLayer → GTM) e planilha (Apps Script).
 */
import { NEGOCIO } from '../data/site.js';
const PLANILHA_URL = 'https://script.google.com/macros/s/AKfycbx8i1b90TqBTfGOYIw4DM84bzEYK9xMGZCWtpXhNpiu8sKnPzflFclyVV7qqfT4Zy2M/exec';
---
<script is:inline define:vars={{ whatsapp: NEGOCIO.whatsapp, planilhaUrl: PLANILHA_URL }}>
(function () {
  window.dataLayer = window.dataLayer || [];
  // Canal: Google Ads (gclid/cpc), GMN (utm_source=gmn), Google orgânico, outro site ou Direto.
  // Guarda 30 dias; visita direta não apaga o canal anterior (mesma regra do GA4).
  var canal = (function () {
    var q = new URLSearchParams(location.search), r = document.referrer, c = '';
    var med = (q.get('utm_medium') || '').toLowerCase(), src = (q.get('utm_source') || '').toLowerCase();
    if (q.get('gclid') || q.get('gbraid') || q.get('wbraid') || /cpc|ppc|paid/.test(med)) c = 'Google Ads';
    else if (src) c = src === 'gmn' ? 'Perfil da Empresa (GMN)' : 'utm: ' + src + (med ? ' / ' + med : '');
    else if (r && r.indexOf(location.host) < 0) c = /\.google\./.test(r) ? 'Google orgânico' : /bing\.|duckduckgo|yahoo/.test(r) ? 'Busca orgânica (outros)' : 'Site: ' + r.split('/')[2];
    try {
      if (c) localStorage.setItem('sr_canal', JSON.stringify({ c: c, t: Date.now() }));
      else { var s = JSON.parse(localStorage.getItem('sr_canal') || 'null'); if (s && Date.now() - s.t < 2592e6) c = s.c; }
    } catch (x) {}
    return c || 'Direto';
  })();
  window.sr = {
    canal: canal,
    codigo: function () { var c = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789', r = 'S-'; for (var i = 0; i < 4; i++) r += c[Math.floor(Math.random() * c.length)]; return r; },
    tel: function (v) { var d = String(v || '').replace(/\D/g, '').replace(/^55(?=\d{10,11}$)/, '').replace(/^0(?=\d{10,11}$)/, ''); if (d.length === 8 || d.length === 9) d = '21' + d; if (d.length < 10 || d.length > 11) return ''; return '(' + d.slice(0, 2) + ') ' + (d.length === 11 ? d.slice(2, 7) + '-' + d.slice(7) : d.slice(2, 6) + '-' + d.slice(6)); },
    mascara: function (v) { var d = String(v || '').replace(/\D/g, '').slice(0, 11); if (d.length <= 2) return d.length ? '(' + d : ''; if (d.length <= 6) return '(' + d.slice(0, 2) + ') ' + d.slice(2); if (d.length <= 10) return '(' + d.slice(0, 2) + ') ' + d.slice(2, 6) + '-' + d.slice(6); return '(' + d.slice(0, 2) + ') ' + d.slice(2, 7) + '-' + d.slice(7); },
    evento: function (nome, p) { p = p || {}; p.event = nome; p.canal = canal; window.dataLayer.push(p); },
    planilha: function (d) { if (!planilhaUrl) return; d.k = 'sr'; d.pagina = location.pathname; d.canal = canal; try { fetch(planilhaUrl, { method: 'POST', mode: 'no-cors', keepalive: true, headers: { 'Content-Type': 'text/plain' }, body: JSON.stringify(d) }); } catch (x) {} },
    origem: function (a) { return a.getAttribute('data-origem') || (a.closest('header') ? 'cabecalho' : a.closest('footer') ? 'rodape' : 'conteudo'); },
    abrir: function (texto) { var a = document.createElement('a'); a.href = 'https://wa.me/' + whatsapp + '?text=' + encodeURIComponent(texto); a.target = '_blank'; a.rel = 'noopener'; a.setAttribute('data-sr-direto', ''); document.body.appendChild(a); a.click(); a.remove(); }
  };
  // Ligar e mapa (delegado). ligacao_click manda o número em cta_source.
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a[href]'); if (!a) return;
    var h = a.getAttribute('href');
    if (h.indexOf('tel:') === 0) {
      var num = h.replace('tel:', '');
      sr.evento('ligacao_click', { cta_source: num });
      sr.planilha({ tipo: 'Ligação (clique)', telefone: 'Número clicado: ' + num, origem: sr.origem(a) });
    } else if (/google\.[^/]+\/maps|maps\.app\.goo\.gl|g\.page/.test(h)) {
      sr.evento('mapa_click', { cta_source: sr.origem(a) });
    }
  }, true);
})();
</script>
