---
/** Rodapé. A lista de serviços sai do conteudo.json — página nova aparece
 *  aqui sozinha, sem editar este arquivo (mas NÃO aparece na grade da home,
 *  que é fixa em src/data/site.js). */
import Icone from './Icone.astro';
import Logo from './Logo.astro';
import { NEGOCIO } from '../data/site.js';
import conteudo from '../data/conteudo.json';
const servicos = Object.values(conteudo).filter((s) => !s.hideFromNav).map((s) => [s.title, '/' + s.slug + '.html']);
---
<footer style="background:var(--blue-950);color:rgba(255,255,255,0.78);padding-top:64px">
<div class="ds-container">
<div class="footer-grid" style="display:grid;grid-template-columns:1.1fr 1.6fr 1fr;gap:48px;padding-bottom:48px">
<div style="display:flex;flex-direction:column;gap:16px;max-width:340px">
<Logo tam={38} tone="light" />
<p style="font-size:var(--fs-sm);line-height:var(--lh-relaxed);margin:0">Refrigeração comercial no Rio de Janeiro e Grande Rio. Instalação, manutenção preventiva e corretiva com técnicos especializados.</p>
<div style="display:flex;gap:12px;margin-top:4px">
<a href={'https://wa.me/' + NEGOCIO.whatsapp} target="_blank" rel="noopener" aria-label="Falar no WhatsApp" style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:var(--radius-md);background:rgba(37,211,102,0.16);color:var(--color-whatsapp)"><Icone nome="message-circle" tam={18} /></a>
<a href={'tel:' + NEGOCIO.telefoneE164} aria-label="Ligar para a Santos Refrigeração" style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:var(--radius-md);background:rgba(255,255,255,0.08);color:var(--cyan-300)"><Icone nome="phone" tam={18} /></a>
</div>
</div>
<div>
<h2 style="color:var(--white);font-size:var(--fs-base);margin:0 0 16px">Serviços</h2>
<ul style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px 20px;font-size:var(--fs-sm)">
{servicos.map(([label, href]) => (<li><a href={href} style="color:rgba(255,255,255,0.78)">{label}</a></li>))}
</ul>
</div>
<div>
<h2 style="color:var(--white);font-size:var(--fs-base);margin:0 0 16px">Contato</h2>
<ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px;font-size:var(--fs-sm)">
<li style="display:flex;gap:10px;align-items:flex-start"><Icone nome="phone" tam={17} cor="var(--cyan-300)" /> {NEGOCIO.telefone}</li>
<li style="display:flex;gap:10px;align-items:flex-start"><Icone nome="map-pin" tam={17} cor="var(--cyan-300)" estilo="margin-top:2px" /> <span>{NEGOCIO.endereco.rua.replace(' - ', ' — ')}, {NEGOCIO.endereco.cidade} - {NEGOCIO.endereco.estado}, {NEGOCIO.endereco.cep}<br><a href={NEGOCIO.google.maps} target="_blank" rel="noopener" style="color:var(--cyan-300);font-weight:600">Ver no Google Maps</a></span></li>
<li style="display:flex;gap:10px;align-items:flex-start"><Icone nome="clock" tam={17} cor="var(--cyan-300)" /> {NEGOCIO.horario}</li>
</ul>
</div>
</div>
<div style="border-top:1px solid rgba(255,255,255,0.1);padding-block:22px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:var(--fs-xs)">
<span>© 2026 Santos Refrigeração · Refrigeração Comercial. CNPJ {NEGOCIO.cnpj}. Todos os direitos reservados.</span>
</div>
</div>
</footer>
