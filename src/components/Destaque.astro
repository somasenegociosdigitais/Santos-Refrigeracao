---
/** Destaca a palavra-chave (singular e plural) dentro de um título —
 *  espelha highlightTitle() do ServicePage.jsx. */
const { texto, termo, cor = 'var(--cyan-300)' } = Astro.props;
let partes = [texto];
if (termo && typeof texto === 'string') {
  const esc = termo.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  partes = texto.split(new RegExp('(' + esc + 's?)', 'ig'));
}
const alvo = (termo || '').toLowerCase();
---
{partes.map((p) => (
  (p || '').toLowerCase() === alvo || (p || '').toLowerCase() === alvo + 's'
    ? <span style={'color:' + cor}>{p}</span>
    : <Fragment>{p}</Fragment>
))}
