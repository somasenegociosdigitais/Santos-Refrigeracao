---
/** Marca Santos Refrigeração — floco em badge azul + wordmark.
 *  Espelha components/brand/Logo.jsx do design system. */
const { tam = 36, tone = 'dark' } = Astro.props;
const claro = tone === 'light';
const topo = claro ? 'var(--white)' : 'var(--color-primary-strong)';
const base = claro ? 'var(--cyan-300)' : 'var(--color-primary)';
---
<span style="display:inline-flex;align-items:center;gap:0.6rem">
<span aria-hidden="true" style={'display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:var(--radius-md);overflow:hidden;background:linear-gradient(150deg,var(--blue-600),var(--blue-800));box-shadow:0 4px 12px rgba(8,42,77,0.28);width:' + tam + 'px;height:' + tam + 'px'}>
<img src="/assets/mascote.png" alt="" width={tam} height={tam} style="width:100%;height:100%;object-fit:cover;display:block">
</span>
<span style="display:flex;flex-direction:column;line-height:1;font-family:var(--font-display);letter-spacing:-0.01em">
<span style={'font-weight:800;color:' + topo + ';font-size:' + (tam*0.5) + 'px'}>Santos</span>
<span style={'font-weight:700;margin-top:2px;color:' + base + ';font-size:' + (tam*0.44) + 'px'}>Refrigeração</span>
</span>
</span>
