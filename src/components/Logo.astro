---
/** Marca Santos Refrigeração — floco em badge azul + wordmark.
 *  Espelha components/brand/Logo.jsx do design system. */
const { tam = 36, tone = 'dark' } = Astro.props;
const claro = tone === 'light';
const topo = claro ? 'var(--white)' : 'var(--color-primary-strong)';
const base = claro ? 'var(--cyan-300)' : 'var(--color-primary)';
---
<span style="display:inline-flex;align-items:center;gap:0.6rem">
<span aria-hidden="true" style={'display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;border-radius:var(--radius-md);background:linear-gradient(150deg,var(--blue-600),var(--blue-800));box-shadow:0 4px 12px rgba(8,42,77,0.28);color:var(--white);width:' + tam + 'px;height:' + tam + 'px'}>
<svg width={tam*0.62} height={tam*0.62} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<path d="m2 12 1.5-1.5M22 12l-1.5 1.5M12 2l1.5 1.5M12 22l-1.5-1.5"></path>
<line x1="12" y1="2" x2="12" y2="22"></line>
<line x1="2" y1="12" x2="22" y2="12"></line>
<line x1="4.5" y1="4.5" x2="19.5" y2="19.5"></line>
<line x1="19.5" y1="4.5" x2="4.5" y2="19.5"></line>
</svg>
</span>
<span style="display:flex;flex-direction:column;line-height:1;font-family:var(--font-display);letter-spacing:-0.01em">
<span style={'font-weight:800;color:' + topo + ';font-size:' + (tam*0.5) + 'px'}>Santos</span>
<span style={'font-weight:700;margin-top:2px;color:' + base + ';font-size:' + (tam*0.44) + 'px'}>Refrigeração</span>
</span>
</span>
