---
/** Artigo do blog. Dados em src/data/blog.json; a rota é pages/blog/[slug].astro.
 *  Schema: BlogPosting (autor e publisher = o nó único do negócio),
 *  BreadcrumbList e FAQPage. Sumário e índice saem dos títulos das seções. */
import Base from './Base.astro';
import Icone from '../components/Icone.astro';
import Faq from '../components/Faq.astro';
import { NEGOCIO, EMPRESA_SCHEMA, wa } from '../data/site.js';

const { dados: d } = Astro.props;
const caminho = '/blog/' + d.slug + '.html';
const url = NEGOCIO.site + caminho;
const zap = wa(d.waMessage);
const MESES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
const dataBr = (iso) => { const [a, m, dia] = iso.split('-').map(Number); return dia + ' de ' + MESES[m - 1] + ' de ' + a; };
const causas = d.sections.map((s) => [s.id, s.title.replace(/^\d+\.\s*/, '')]);

const jsonld = [
  { '@context': 'https://schema.org', ...EMPRESA_SCHEMA },
  { '@context': 'https://schema.org', '@type': 'BlogPosting', '@id': url + '#artigo', headline: d.title, description: d.metaDescription, image: NEGOCIO.site + d.cover, datePublished: d.published, dateModified: d.updated || d.published, inLanguage: 'pt-BR', author: { '@id': EMPRESA_SCHEMA['@id'] }, publisher: { '@id': EMPRESA_SCHEMA['@id'] }, mainEntityOfPage: url, articleSection: d.category },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: NEGOCIO.site + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: NEGOCIO.site + '/blog.html' },
    { '@type': 'ListItem', position: 3, name: d.title },
  ] },
];
if (d.faq && d.faq.length) {
  jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) });
}
---
<Base titulo={d.metaTitle} descricao={d.metaDescription} caminho={caminho} jsonld={jsonld} zapHref={zap} imagem={d.cover}>

<section style="background:linear-gradient(135deg,var(--blue-900) 0%,var(--blue-700) 60%,var(--blue-600) 100%);color:var(--white)">
<div class="ds-container" style="padding-block:clamp(40px,6vw,72px)">
<div class="art-hero">
<div style="display:flex;flex-direction:column;gap:18px">
<div style="display:flex;align-items:center;gap:8px;font-size:var(--fs-sm);color:rgba(255,255,255,0.7);flex-wrap:wrap">
<a href="/" style="color:rgba(255,255,255,0.7)">Início</a>
<Icone nome="chevron-right" tam={14} />
<a href="/blog.html" style="color:rgba(255,255,255,0.7)">Blog</a>
<Icone nome="chevron-right" tam={14} />
<span style="color:var(--cyan-300)">{d.category}</span>
</div>
<h1 style="font-size:var(--fs-h1);line-height:1.08;color:var(--white);margin:0;text-wrap:balance">{d.title}</h1>
<p style="font-size:var(--fs-lg);color:rgba(255,255,255,0.86);margin:0;line-height:var(--lh-normal);text-wrap:pretty">{d.lead}</p>
<div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap;font-size:var(--fs-sm);color:rgba(255,255,255,0.75)">
<span>Por Santos Refrigeração</span>
<time datetime={d.published}>{dataBr(d.published)}</time>
<span style="display:inline-flex;align-items:center;gap:6px"><Icone nome="clock" tam={15} cor="var(--cyan-300)" />{d.readMin} min de leitura</span>
</div>
</div>
<img class="art-capa" src={d.cover} alt={d.coverAlt} width="720" height="900" decoding="async" fetchpriority="high">
</div>
</div>
</section>

<section style="background:var(--surface-page);padding-block:clamp(48px,7vw,80px)">
<div class="ds-container">
<article class="art">

<nav aria-labelledby="resumo" class="art-resumo">
<h2 id="resumo" style="font-size:var(--fs-h4);margin:0">{d.summaryTitle}</h2>
<ol>
{causas.map(([id, t]) => (<li><a href={'#' + id}>{t}</a></li>))}
</ol>
</nav>

{d.sections.map((s) => (
  <section id={s.id} class="art-sec">
  <h2>{s.title}</h2>
  {s.body.map((p) => (<p set:html={p}></p>))}
  {s.image && (
    <figure>
    <img src={s.image.src} alt={s.image.alt} width="900" height="1200" loading="lazy" decoding="async">
    <figcaption>{s.image.caption}</figcaption>
    </figure>
  )}
  </section>
))}

{d.diagnosis && (
  <section id="diagnostico" class="art-sec art-diag">
  <h2>{d.diagnosis.title}</h2>
  <p>{d.diagnosis.intro}</p>
  <ol>
  {d.diagnosis.steps.map((st, i) => (<li><span>{i + 1}</span><span>{st}</span></li>))}
  </ol>
  <p>{d.diagnosis.after}</p>
  </section>
)}

{d.cta && (
  <section class="art-cta">
  <h2>{d.cta.title}</h2>
  <p>{d.cta.body}</p>
  <div style="display:flex;gap:12px;flex-wrap:wrap">
  <a href={zap} target="_blank" rel="noopener nofollow" style="display:inline-flex;align-items:center;gap:10px;background:var(--color-whatsapp);color:var(--white);font-family:var(--font-body);font-weight:700;padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="message-circle" tam={20} />Chamar no WhatsApp</a>
  <a href={'tel:' + NEGOCIO.telefoneE164} style="display:inline-flex;align-items:center;gap:10px;background:var(--white);border:1px solid var(--border-default);color:var(--text-strong);font-family:var(--font-body);font-weight:700;padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="phone" tam={18} />{NEGOCIO.telefone}</a>
  </div>
  </section>
)}

{d.faq && d.faq.length > 0 && (
  <section class="art-sec">
  <h2>Perguntas frequentes</h2>
  <Faq itens={d.faq} />
  </section>
)}

{d.related && d.related.length > 0 && (
  <section class="art-sec">
  <h2>Serviços relacionados</h2>
  <div class="art-rel">
  {d.related.map(([label, href, ic, txt]) => (
    <a href={href}>
    <span class="art-rel__ic"><Icone nome={ic} tam={22} /></span>
    <span style="display:flex;flex-direction:column;gap:4px"><strong>{label}</strong><span>{txt}</span></span>
    <Icone nome="arrow-right" tam={18} />
    </a>
  ))}
  </div>
  </section>
)}

</article>
</div>
</section>

<style>
.art-hero{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:clamp(28px,5vw,56px);align-items:center}
.art-capa{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);background:var(--white)}
.art{max-width:760px;margin-inline:auto;display:flex;flex-direction:column;gap:clamp(36px,5vw,52px)}
.art-resumo{background:var(--surface-subtle);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);padding:clamp(22px,3vw,30px);display:flex;flex-direction:column;gap:14px}
.art-resumo ol{margin:0;padding-left:1.4em;display:flex;flex-direction:column;gap:8px;font-size:var(--fs-base);color:var(--text-body)}
.art-resumo a{color:var(--color-primary);font-weight:600}
.art-sec{display:flex;flex-direction:column;gap:16px;scroll-margin-top:130px}
.art-sec h2{font-size:var(--fs-h3);margin:0;text-wrap:balance}
.art-sec p{font-size:var(--fs-base);color:var(--text-muted);margin:0;line-height:var(--lh-relaxed);text-wrap:pretty}
.art-sec p :global(a){color:var(--color-primary);font-weight:700}
.art-sec p :global(strong){color:var(--text-strong)}
.art-sec figure{margin:8px 0 0;display:flex;flex-direction:column;gap:10px}
.art-sec figure img{width:100%;max-width:440px;aspect-ratio:3/4;object-fit:cover;border-radius:var(--radius-lg);border:1px solid var(--border-subtle);box-shadow:var(--shadow-sm)}
.art-sec figcaption{font-size:var(--fs-sm);color:var(--text-muted);max-width:440px}
.art-diag ol{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px}
.art-diag li{display:flex;gap:14px;align-items:flex-start;background:var(--white);border:1px solid var(--border-subtle);border-radius:var(--radius-md);padding:14px 18px;font-size:var(--fs-base);color:var(--text-body);line-height:var(--lh-normal)}
.art-diag li span:first-child{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:var(--radius-pill);background:var(--color-primary);color:var(--white);font-family:var(--font-display);font-weight:700;font-size:var(--fs-sm)}
.art-diag li span:last-child{padding-top:3px}
.art-cta{background:var(--blue-100);border:1px solid var(--blue-200);border-radius:var(--radius-lg);padding:clamp(24px,4vw,36px);display:flex;flex-direction:column;gap:16px}
.art-cta h2{font-size:var(--fs-h3);margin:0}
.art-cta p{font-size:var(--fs-base);color:var(--text-body);margin:0;line-height:var(--lh-relaxed)}
.art-sec :global(.faq){margin-inline:0;max-width:none}
.art-rel{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.art-rel a{display:flex;align-items:center;gap:14px;background:var(--white);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:18px;text-decoration:none;color:var(--color-primary)}
.art-rel a:hover{border-color:var(--blue-200);text-decoration:none}
.art-rel strong{font-family:var(--font-display);color:var(--text-strong);font-size:var(--fs-base)}
.art-rel a span span{font-size:var(--fs-sm);color:var(--text-muted);line-height:var(--lh-normal)}
.art-rel__ic{flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:var(--radius-md);background:var(--blue-100);color:var(--color-primary)}
@media (max-width:860px){.art-hero{grid-template-columns:1fr}.art-capa{max-width:420px;aspect-ratio:4/3}.art-rel{grid-template-columns:1fr}}
</style>

</Base>
