---
/**
 * Layout base. Monta o <head> inteiro no build: title, description, canonical,
 * Open Graph e o JSON-LD. Nada de SEO é injetado por script no navegador —
 * era o que o ServicePage.jsx fazia com useEffect.
 *
 * props:
 *   titulo     obrigatório
 *   descricao  obrigatório
 *   caminho    caminho da URL desta página, com .html ('/' na home)
 *   jsonld     array de nós schema.org, já prontos
 *   imagem     og:image (caminho relativo à raiz)
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ZapFlutuante from '../components/ZapFlutuante.astro';
import ModalWhatsapp from '../components/ModalWhatsapp.astro';
import { NEGOCIO } from '../data/site.js';

const { titulo, descricao, caminho, jsonld = [], imagem = '/assets/gelinho-grande.png', ogTitulo, ogDescricao, zapHref } = Astro.props;
const url = NEGOCIO.site + caminho;
const desc = descricao.replace(/\s+/g, ' ').trim();
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Google Tag Manager -->
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-PQFJGP3Z');</script>
<!-- End Google Tag Manager -->
<title>{titulo}</title>
<meta name="description" content={desc}>
<link rel="canonical" href={url}>
<meta name="robots" content="index,follow,max-image-preview:large">
<meta name="geo.region" content="BR-RJ">
<meta name="geo.placename" content="Rio de Janeiro">
<meta property="og:type" content="website">
<meta property="og:locale" content="pt_BR">
<meta property="og:site_name" content={NEGOCIO.marca}>
<meta property="og:title" content={ogTitulo || titulo}>
<meta property="og:description" content={ogDescricao || desc}>
<meta property="og:url" content={url}>
<meta property="og:image" content={NEGOCIO.site + imagem}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0B3C6B">
<link rel="icon" href="/assets/favicon-192.png" type="image/png" sizes="192x192">
<link rel="icon" href="/assets/favicon-512.png" type="image/png" sizes="512x512">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="preload" href="/fonts/poppins-800.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/mulish-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/mulish-600.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/mulish-700.woff2" as="font" type="font/woff2" crossorigin>
{jsonld.map((no) => (
  <script type="application/ld+json" set:html={JSON.stringify(no)}></script>
))}
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PQFJGP3Z" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
<a class="pular" href="#conteudo">Ir para o conteúdo</a>
<Header />
<main id="conteudo">
<slot />
</main>
<Footer />
<ZapFlutuante href={zapHref} />
<ModalWhatsapp />
<script is:inline>
/* Ligar e mapa. WhatsApp fica no ModalWhatsapp. ligacao_click manda o número
   em cta_source (botões só com ícone não têm texto). */
document.addEventListener('click', function (e) {
  var a = e.target.closest && e.target.closest('a[href]'); if (!a || !window.sr) return;
  var h = a.getAttribute('href');
  if (h.indexOf('tel:') === 0) {
    var num = h.replace('tel:', '');
    sr.evento('ligacao_click', { cta_source: num });
    sr.planilha({ tipo: 'Ligação (clique)', telefone: 'Número clicado: ' + num, origem: sr.origem(a) });
  } else if (/google\.[^/]+\/maps|maps\.app\.goo\.gl|g\.page/.test(h)) {
    sr.evento('mapa_click', { cta_source: sr.origem(a) });
  }
}, true);
</script>
</body>
</html>
