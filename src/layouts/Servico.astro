---
/** Página de serviço — mesma estrutura do ServicePage.jsx: herói azul com
 *  breadcrumb, "O que fazemos" + checklist, seções extras, hub, galeria com
 *  lightbox, sinais de alerta, bloco de emergência, FAQ e faixa de CTA.
 *  Tudo estático: o lightbox abre por :target, o FAQ por <details>. */
import Base from './Base.astro';
import Icone from '../components/Icone.astro';
import Destaque from '../components/Destaque.astro';
import Faq from '../components/Faq.astro';
import { NEGOCIO, wa } from '../data/site.js';

const { dados: d } = Astro.props;
const caminho = '/' + d.slug + '.html';
const url = NEGOCIO.site + caminho;
const zap = wa(d.waMessage);

const empresa = {
  '@type': 'LocalBusiness',
  name: NEGOCIO.nome,
  taxID: NEGOCIO.cnpj,
  telephone: '+55-21-96782-6279',
  areaServed: 'Rio de Janeiro e Grande Rio',
  address: {
    '@type': 'PostalAddress',
    streetAddress: NEGOCIO.endereco.rua,
    addressLocality: NEGOCIO.endereco.cidade,
    addressRegion: NEGOCIO.endereco.estado,
    postalCode: NEGOCIO.endereco.cep,
    addressCountry: NEGOCIO.endereco.pais,
  },
};

const jsonld = [
  { '@context': 'https://schema.org', '@type': 'Service', serviceType: d.title, provider: empresa, areaServed: 'Rio de Janeiro e Grande Rio', description: d.metaDescription, url },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: NEGOCIO.site + '/' },
    { '@type': 'ListItem', position: 2, name: 'Serviços', item: NEGOCIO.site + '/#servicos' },
    { '@type': 'ListItem', position: 3, name: d.title },
  ] },
];
if (d.faq && d.faq.length) {
  jsonld.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) });
}
const accent = 'var(--color-accent-strong)';
---
<Base titulo={d.metaTitle} descricao={d.metaDescription} caminho={caminho} jsonld={jsonld} zapHref={zap}>

<section style="background:linear-gradient(135deg,var(--blue-900) 0%,var(--blue-700) 60%,var(--blue-600) 100%);position:relative;overflow:hidden;color:var(--white)">
<div style="position:absolute;top:-120px;right:-80px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(32,190,220,0.22),transparent 70%)"></div>
<div class="ds-container" style="position:relative;padding-block:clamp(48px,7vw,80px)">
<div style="display:flex;align-items:center;gap:8px;font-size:var(--fs-sm);color:rgba(255,255,255,0.7);margin-bottom:22px;flex-wrap:wrap">
<a href="/" style="color:rgba(255,255,255,0.7)">Início</a>
<Icone nome="chevron-right" tam={14} />
<a href="/#servicos" style="color:rgba(255,255,255,0.7)">Serviços</a>
<Icone nome="chevron-right" tam={14} />
<span style="color:var(--cyan-300)">{d.title}</span>
</div>
<div style="display:flex;flex-direction:column;gap:20px">
<span style="display:inline-flex;align-items:center;gap:8px;align-self:flex-start;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.18);padding:7px 14px;border-radius:var(--radius-pill);font-size:var(--fs-sm);font-weight:700">
<Icone nome={d.icon} tam={16} cor="var(--cyan-300)" /> {d.eyebrow}
</span>
<h1 style="font-size:var(--fs-h1);line-height:1.05;color:var(--white);margin:0;text-wrap:balance"><Destaque texto={d.heroTitle} termo={d.highlight} /></h1>
<p style="font-size:var(--fs-lg);color:rgba(255,255,255,0.85);margin:0;max-width:640px;line-height:var(--lh-normal);text-wrap:pretty" set:html={d.heroLead}></p>
<div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:6px">
<a href={zap} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;background:var(--color-whatsapp);color:var(--white);font-family:var(--font-body);font-weight:700;font-size:var(--fs-base);padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="message-circle" tam={20} />Peça seu orçamento</a>
<a href={'tel:' + NEGOCIO.telefoneE164} style="display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.3);color:var(--white);font-family:var(--font-body);font-weight:700;font-size:var(--fs-base);padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="phone" tam={18} />{NEGOCIO.telefone}</a>
</div>
</div>
</div>
</section>

<section style="background:var(--surface-page);padding-block:clamp(56px,8.5vw,92px)">
<div class="ds-container">
<div class="split-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,56px);align-items:flex-start">
<div style="display:flex;flex-direction:column;gap:18px">
<span class="ds-eyebrow">O que fazemos</span>
<h2 style="font-size:var(--fs-h2);margin:0;text-wrap:balance"><Destaque texto={d.servicesTitle} termo={d.highlight} cor={accent} /></h2>
{d.intro.map((p) => (<p style="font-size:var(--fs-base);color:var(--text-muted);margin:0;line-height:var(--lh-relaxed)">{p}</p>))}
<p style="font-size:var(--fs-base);color:var(--text-muted);margin:0;line-height:var(--lh-relaxed)">Conheça também os <a href="/" style="color:var(--color-primary);font-weight:700">outros serviços de refrigeração comercial da Santos Refrigeração</a>, no Rio e Grande Rio.</p>
</div>
<div style="background:var(--surface-card);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:clamp(22px,3vw,32px);display:flex;flex-direction:column;gap:16px">
<h3 style="font-size:var(--fs-h4);margin:0"><Destaque texto={d.servicesListTitle} termo={d.highlight} cor={accent} /></h3>
<div style="display:flex;flex-direction:column;gap:13px">
{d.services.map((s) => (
  <span style="display:flex;gap:10px;align-items:flex-start;font-family:var(--font-body);font-size:var(--fs-base);color:var(--text-body);line-height:var(--lh-normal)">
  <span style="flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:var(--radius-pill);background:var(--blue-100);color:var(--color-primary);margin-top:1px"><Icone nome="badge-check" tam={14} /></span>
  {s}
  </span>
))}
</div>
</div>
</div>
</div>
</section>

{d.sections && d.sections.length > 0 && (
<section style="background:var(--surface-subtle);padding-block:clamp(56px,8.5vw,92px)">
<div class="ds-container">
<div style="max-width:900px;margin-inline:auto;display:flex;flex-direction:column;gap:clamp(32px,4vw,44px)">
{d.sections.map((sec) => (
  <div style="display:flex;flex-direction:column;gap:14px">
  <h2 style="font-size:var(--fs-h3);margin:0;text-wrap:balance"><Destaque texto={sec.title} termo={d.highlight} cor={accent} /></h2>
  {sec.body.map((p) => (<p style="font-size:var(--fs-base);color:var(--text-muted);margin:0;line-height:var(--lh-relaxed)" set:html={p}></p>))}
  </div>
))}
</div>
</div>
</section>
)}

{d.hubLinks && d.hubLinks.length > 0 && (
<section style="background:var(--surface-page);padding-block:clamp(56px,8.5vw,92px)">
<div class="ds-container">
<div style="display:flex;flex-direction:column;gap:12px;align-items:center;text-align:center;max-width:680px;margin-inline:auto;margin-bottom:clamp(32px,5vw,48px)">
<span class="ds-eyebrow">Equipamentos</span>
<h2 style="font-size:var(--fs-h2);margin:0;text-wrap:balance">{d.hubTitle || 'Equipamentos que atendemos'}</h2>
<p style="font-size:var(--fs-lg);color:var(--text-muted);margin:0;line-height:var(--lh-normal)">Clique no equipamento para ver o serviço em detalhe.</p>
</div>
<div class="cards-grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px">
{d.hubLinks.map(([label, href, ic, txt]) => (
  <a href={href} style="text-decoration:none;background:var(--white);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:var(--space-6);display:flex;flex-direction:column;gap:10px">
  <span style="display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:var(--radius-md);background:var(--blue-100);color:var(--color-primary)"><Icone nome={ic} tam={22} /></span>
  <h3 style="font-size:var(--fs-h4);margin:0;color:var(--text-strong)">{label}</h3>
  <p style="font-size:var(--fs-sm);color:var(--text-muted);margin:0;line-height:var(--lh-normal)">{txt}</p>
  </a>
))}
</div>
</div>
</section>
)}

{d.gallery && d.gallery.length > 0 && (
<section style="background:var(--surface-page);padding-block:clamp(56px,8.5vw,92px)">
<div class="ds-container">
<div style="display:flex;flex-direction:column;gap:12px;align-items:center;text-align:center;max-width:680px;margin-inline:auto;margin-bottom:clamp(32px,5vw,48px)">
<span class="ds-eyebrow">Trabalhos realizados</span>
<h2 style="font-size:var(--fs-h2);margin:0;text-wrap:balance"><Destaque texto={d.galleryTitle || 'Serviços de chopeira que já executamos'} termo={d.highlight} cor={accent} /></h2>
<p style="font-size:var(--fs-lg);color:var(--text-muted);margin:0;line-height:var(--lh-normal)">{d.galleryLead || 'Instalações e manutenções reais feitas pela nossa equipe.'}</p>
</div>
<div class="gallery-grid" style={'display:grid;gap:16px;grid-template-columns:repeat(' + (d.galleryCols || 4) + ',1fr)'}>
{d.gallery.map((src, i) => (
  <a href={'#foto-' + d.slug + '-' + i} style={'display:block;padding:0;border:1px solid var(--border-subtle);border-radius:var(--radius-lg);overflow:hidden;background:var(--white);box-shadow:var(--shadow-sm);aspect-ratio:' + (d.galleryAspect || '3 / 4')}>
  <img src={src} alt={(d.galleryAlt || 'Serviço de chopeira realizado pela Santos Refrigeração') + ' ' + (i + 1)} loading="lazy" decoding="async" style={'width:100%;display:block;height:' + (d.galleryTrim ? (100 + d.galleryTrim) + '%' : '100%') + ';object-fit:' + (d.galleryFit || 'contain') + ';object-position:' + ((d.galleryPos && d.galleryPos[i]) || (d.galleryTrim ? 'center top' : 'center'))}>
  </a>
))}
</div>
</div>
</section>
)}

{d.gallery && d.gallery.length > 0 && d.gallery.map((src, i) => (
  <div id={'foto-' + d.slug + '-' + i} class="lightbox">
  <a href="#" class="lightbox__fundo" aria-label="Fechar"></a>
  <img src={src} alt="">
  <a href="#" class="lightbox__x" aria-label="Fechar"><Icone nome="x" tam={24} /></a>
  </div>
))}

<section style="background:var(--surface-subtle);padding-block:clamp(56px,8.5vw,92px)">
<div class="ds-container">
<div style="display:flex;flex-direction:column;gap:12px;align-items:center;text-align:center;max-width:680px;margin-inline:auto;margin-bottom:clamp(32px,5vw,48px)">
<span class="ds-eyebrow">Sinais de alerta</span>
<h2 style="font-size:var(--fs-h2);margin:0;text-wrap:balance"><Destaque texto={d.signsTitle} termo={d.highlight} cor={accent} /></h2>
<p style="font-size:var(--fs-lg);color:var(--text-muted);margin:0;line-height:var(--lh-normal)">Notou algum destes sintomas? É hora de chamar um técnico antes que o prejuízo aumente.</p>
</div>
<div class="cards-grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px">
{d.signs.map(([ic, titulo, txt, link]) => (
  <div style="background:var(--white);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:var(--space-6);display:flex;flex-direction:column;gap:12px">
  <span style="display:inline-flex;align-items:center;justify-content:center;width:50px;height:50px;border-radius:var(--radius-md);background:var(--blue-100);color:var(--color-primary)"><Icone nome={ic} tam={24} /></span>
  <h3 style="font-size:var(--fs-h4);margin:0">{titulo}</h3>
  <p style="font-size:var(--fs-sm);color:var(--text-muted);margin:0;line-height:var(--lh-normal)">{txt}</p>
  {link && (<a href={link[1]} style="margin-top:auto;padding-top:4px;display:inline-flex;align-items:center;gap:6px;font-size:var(--fs-sm);font-weight:700;color:var(--color-primary);text-decoration:none">{link[0]} <Icone nome="arrow-right" tam={14} /></a>)}
  </div>
))}
</div>
</div>
</section>

{d.emergency && (
<section style="background:var(--surface-page);padding-block:clamp(56px,8.5vw,92px)">
<div class="ds-container">
<div style="max-width:900px;margin-inline:auto;background:var(--blue-100);border:1px solid var(--blue-200);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);padding:clamp(28px,4vw,40px);display:flex;flex-direction:column;gap:16px">
<span style="font-family:var(--font-body);font-size:var(--fs-sm);font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--color-primary)">Atendimento de emergência</span>
<h2 style="font-family:var(--font-display);font-size:var(--fs-h2);margin:0;text-wrap:balance">Equipamento parado não espera horário comercial</h2>
<p style="font-family:var(--font-body);font-size:var(--fs-lg);color:var(--text-muted);margin:0;line-height:var(--lh-normal);text-wrap:pretty">{d.emergency}</p>
<div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:4px">
<a href={zap} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;background:var(--color-whatsapp);color:var(--white);font-family:var(--font-body);font-weight:700;padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="message-circle" tam={20} />Chamar no WhatsApp</a>
<a href={'tel:' + NEGOCIO.telefoneE164} style="display:inline-flex;align-items:center;gap:10px;background:var(--white);border:1px solid var(--border-default);color:var(--text-strong);font-family:var(--font-body);font-weight:700;padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="phone" tam={18} />{NEGOCIO.telefone}</a>
</div>
</div>
</div>
</section>
)}

{d.faq && d.faq.length > 0 && (
<section style="background:var(--surface-page);padding-block:clamp(56px,8.5vw,92px)">
<div class="ds-container">
<div style="display:flex;flex-direction:column;gap:12px;align-items:center;text-align:center;max-width:680px;margin-inline:auto;margin-bottom:clamp(32px,5vw,48px)">
<span class="ds-eyebrow">Perguntas frequentes</span>
<h2 style="font-size:var(--fs-h2);margin:0;text-wrap:balance"><Destaque texto={d.faqTitle || ('Dúvidas sobre ' + d.title)} termo={d.highlight} cor={accent} /></h2>
</div>
<Faq itens={d.faq} />
</div>
</section>
)}

<section style="background:linear-gradient(135deg,var(--blue-900),var(--blue-700));padding-block:clamp(48px,7vw,64px)">
<div class="ds-container" style="display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap">
<div style="max-width:640px">
<h2 style="font-size:var(--fs-h2);color:var(--white);margin:0 0 8px;text-wrap:balance"><Destaque texto={d.ctaTitle} termo={d.highlight} /></h2>
<p style="font-size:var(--fs-lg);color:rgba(255,255,255,0.82);margin:0">Orçamento sem compromisso. Atendimento rápido no Rio e Grande Rio.</p>
</div>
<div style="display:flex;gap:12px;flex-wrap:wrap">
<a href={zap} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;background:var(--color-whatsapp);color:var(--white);font-family:var(--font-body);font-weight:700;padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="message-circle" tam={20} />Falar no WhatsApp</a>
<a href="/#servicos" style="display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.3);color:var(--white);font-family:var(--font-body);font-weight:700;padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="arrow-left" tam={18} />Ver outros serviços</a>
</div>
</div>
</section>

</Base>
