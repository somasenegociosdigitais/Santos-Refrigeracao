---
/** Ícones lucide inlinados no build a partir do lucide-static — o mesmo
 *  conjunto que o site usa hoje via CDN, na mesma versão (0.323.0).
 *  Sai como <svg> dentro do HTML: nada para baixar, nada para executar,
 *  e acaba o reflow forçado do lucide.createIcons().
 *  Uso: <Icone nome="phone" tam={16} cor="var(--cyan-300)" /> */
import airVent from 'lucide-static/icons/air-vent.svg?raw';
import alertTriangle from 'lucide-static/icons/alert-triangle.svg?raw';
import arrowDown from 'lucide-static/icons/arrow-down.svg?raw';
import arrowLeft from 'lucide-static/icons/arrow-left.svg?raw';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import badgeCheck from 'lucide-static/icons/badge-check.svg?raw';
import beer from 'lucide-static/icons/beer.svg?raw';
import boxes from 'lucide-static/icons/boxes.svg?raw';
import chevronDown from 'lucide-static/icons/chevron-down.svg?raw';
import chevronLeft from 'lucide-static/icons/chevron-left.svg?raw';
import chevronRight from 'lucide-static/icons/chevron-right.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import cuboid from 'lucide-static/icons/cuboid.svg?raw';
import cupSoda from 'lucide-static/icons/cup-soda.svg?raw';
import doorOpen from 'lucide-static/icons/door-open.svg?raw';
import droplet from 'lucide-static/icons/droplet.svg?raw';
import droplets from 'lucide-static/icons/droplets.svg?raw';
import filter from 'lucide-static/icons/filter.svg?raw';
import gauge from 'lucide-static/icons/gauge.svg?raw';
import gitBranch from 'lucide-static/icons/git-branch.svg?raw';
import glassWater from 'lucide-static/icons/glass-water.svg?raw';
import image from 'lucide-static/icons/image.svg?raw';
import lightbulb from 'lucide-static/icons/lightbulb.svg?raw';
import lock from 'lucide-static/icons/lock.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import menu from 'lucide-static/icons/menu.svg?raw';
import messageCircle from 'lucide-static/icons/message-circle.svg?raw';
import pacote from 'lucide-static/icons/package.svg?raw';
import phone from 'lucide-static/icons/phone.svg?raw';
import plugZap from 'lucide-static/icons/plug-zap.svg?raw';
import power from 'lucide-static/icons/power.svg?raw';
import refrigerator from 'lucide-static/icons/refrigerator.svg?raw';
import rotateCw from 'lucide-static/icons/rotate-cw.svg?raw';
import send from 'lucide-static/icons/send.svg?raw';
import shieldCheck from 'lucide-static/icons/shield-check.svg?raw';
import snowflake from 'lucide-static/icons/snowflake.svg?raw';
import sprayCan from 'lucide-static/icons/spray-can.svg?raw';
import store from 'lucide-static/icons/store.svg?raw';
import thermometerSnowflake from 'lucide-static/icons/thermometer-snowflake.svg?raw';
import thermometerSun from 'lucide-static/icons/thermometer-sun.svg?raw';
import truck from 'lucide-static/icons/truck.svg?raw';
import volume2 from 'lucide-static/icons/volume-2.svg?raw';
import warehouse from 'lucide-static/icons/warehouse.svg?raw';
import wind from 'lucide-static/icons/wind.svg?raw';
import wine from 'lucide-static/icons/wine.svg?raw';
import wrench from 'lucide-static/icons/wrench.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';
import zap from 'lucide-static/icons/zap.svg?raw';

const LUCIDE = {
  'air-vent': airVent,
  'alert-triangle': alertTriangle,
  'arrow-down': arrowDown,
  'arrow-left': arrowLeft,
  'arrow-right': arrowRight,
  'badge-check': badgeCheck,
  'beer': beer,
  'boxes': boxes,
  'chevron-down': chevronDown,
  'chevron-left': chevronLeft,
  'chevron-right': chevronRight,
  'clock': clock,
  'cuboid': cuboid,
  'cup-soda': cupSoda,
  'door-open': doorOpen,
  'droplet': droplet,
  'droplets': droplets,
  'filter': filter,
  'gauge': gauge,
  'git-branch': gitBranch,
  'glass-water': glassWater,
  'image': image,
  'lightbulb': lightbulb,
  'lock': lock,
  'map-pin': mapPin,
  'menu': menu,
  'message-circle': messageCircle,
  'package': pacote,
  'phone': phone,
  'plug-zap': plugZap,
  'power': power,
  'refrigerator': refrigerator,
  'rotate-cw': rotateCw,
  'send': send,
  'shield-check': shieldCheck,
  'snowflake': snowflake,
  'spray-can': sprayCan,
  'store': store,
  'thermometer-snowflake': thermometerSnowflake,
  'thermometer-sun': thermometerSun,
  'truck': truck,
  'volume-2': volume2,
  'warehouse': warehouse,
  'wind': wind,
  'wine': wine,
  'wrench': wrench,
  'x': x,
  'zap': zap,
};

const { nome, tam = 22, cor, largura = 2, estilo = '' } = Astro.props;
const bruto = LUCIDE[nome] || LUCIDE['snowflake'];
const svg = bruto
  .replace(/\swidth="[^"]*"/, ' width="' + tam + '"')
  .replace(/\sheight="[^"]*"/, ' height="' + tam + '"')
  .replace(/\sstroke-width="[^"]*"/, ' stroke-width="' + largura + '"')
  .replace('<svg', '<svg aria-hidden="true" focusable="false" style="flex:0 0 auto;' + (cor ? 'color:' + cor + ';' : '') + estilo + '"');
---
<Fragment set:html={svg} />
