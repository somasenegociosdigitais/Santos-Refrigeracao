---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import { NEGOCIO, AREAS, GRADE_HOME, wa } from '../data/site.js';
import conteudo from '../data/conteudo.json';

const zap = wa('Olá! Vim pelo site e preciso de atendimento em refrigeração comercial.');
const zapOutro = wa('Olá! Não encontrei meu equipamento no site. Vocês atendem?');

const jsonld = [{
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  '@id': NEGOCIO.site + '/#business',
  name: NEGOCIO.nome,
  description: 'Refrigeração comercial no Rio de Janeiro e Grande Rio. Instalação, manutenção preventiva e corretiva de câmara fria, chopeira, ar condicionado, geladeira comercial e demais equipamentos.',
  url: NEGOCIO.site + '/',
  telephone: '+55-21-96782-6279',
  priceRange: '$$',
  image: NEGOCIO.site + '/assets/opt-s1.webp',
  address: {
    '@type': 'PostalAddress',
    streetAddress: NEGOCIO.endereco.rua,
    addressLocality: NEGOCIO.endereco.cidade,
    addressRegion: NEGOCIO.endereco.estado,
    postalCode: NEGOCIO.endereco.cep,
    addressCountry: NEGOCIO.endereco.pais,
  },
  geo: { '@type': 'GeoCoordinates', latitude: NEGOCIO.geo.lat, longitude: NEGOCIO.geo.lng },
  areaServed: [{ '@type': 'City', name: 'Rio de Janeiro' }, { '@type': 'AdministrativeArea', name: 'Grande Rio' }],
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'], opens: '08:00', closes: '18:00' }],
  taxID: NEGOCIO.cnpj,
  sameAs: [NEGOCIO.google.perfil],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Serviços de refrigeração comercial',
    itemListElement: Object.values(conteudo).map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.title } })),
  },
}];

const confia = [
  ['wrench', 'Instalação e manutenção', 'Preventiva e corretiva em todos os equipamentos de refrigeração.'],
  ['map-pin', 'No local ou na oficina', 'Atendemos no seu endereço ou na nossa oficina, bem localizada no Rio.'],
  ['badge-check', 'Técnicos especializados', 'Equipe experiente, peças de qualidade e garantia no serviço.'],
];
---
<Base
  titulo="Santos Refrigeração — Refrigeração Comercial no Rio de Janeiro e Grande Rio"
  descricao="Refrigeração comercial no Rio de Janeiro e Grande Rio: câmara fria, chopeira, ar condicionado, geladeira comercial e mais. Instalação, manutenção e conserto com técnicos especializados. Orçamento sem compromisso."
  caminho="/"
  ogTitulo="Santos Refrigeração — Refrigeração Comercial no Rio e Grande Rio"
  ogDescricao="Instalação, manutenção e conserto de equipamentos de refrigeração comercial no Rio de Janeiro e Grande Rio. Atendimento rápido e orçamento sem compromisso."
  jsonld={jsonld}
>

<section style="background:linear-gradient(135deg,var(--blue-900) 0%,var(--blue-700) 60%,var(--blue-600) 100%);position:relative;overflow:hidden;color:var(--white)">
<div style="position:absolute;top:-120px;right:-80px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(32,190,220,0.22),transparent 70%)"></div>
<div class="ds-container" style="position:relative;padding-block:clamp(56px,9vw,96px)">
<div style="display:flex;flex-direction:column;gap:24px;align-items:center;text-align:center;max-width:780px;margin-inline:auto">
<span style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.18);padding:7px 14px;border-radius:var(--radius-pill);font-size:var(--fs-sm);font-weight:700"><Icone nome="snowflake" tam={16} cor="var(--cyan-300)" /> Refrigeração comercial</span>
<h1 style="font-size:clamp(2.15rem,1.1rem + 4.4vw,3.4rem);line-height:1.05;color:var(--white);margin:0;text-wrap:balance"><span style="color:var(--cyan-300)">Refrigeração comercial</span> com agilidade no Rio e Grande Rio</h1>
<div style="display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-top:6px">
<a href="/contato.html" style="display:inline-flex;align-items:center;gap:10px;background:var(--color-whatsapp);color:var(--white);font-family:var(--font-body);font-weight:700;font-size:var(--fs-base);padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="message-circle" tam={20} />Peça seu orçamento</a>
<a href="#servicos" style="display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.3);color:var(--white);font-family:var(--font-body);font-weight:700;font-size:var(--fs-base);padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="arrow-down" tam={18} />Ver serviços</a>
</div>
<div style="display:flex;gap:22px;flex-wrap:wrap;justify-content:center;margin-top:12px">
{[['shield-check','Orçamento sem compromisso'],['truck','Atendemos no local'],['clock','Resposta rápida']].map(([ic, tx]) => (
  <span style="display:inline-flex;align-items:center;gap:8px;font-size:var(--fs-sm);font-weight:600;color:rgba(255,255,255,0.9)"><Icone nome={ic} tam={18} cor="var(--cyan-300)" /> {tx}</span>
))}
</div>
</div>
</div>
</section>

<div class="ds-container" style="margin-top:-44px;position:relative;z-index:2">
<div class="trust-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px">
{confia.map(([ic, titulo, txt]) => (
  <div style="background:var(--white);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:24px;display:flex;gap:16px;align-items:flex-start">
  <span style="display:inline-flex;align-items:center;justify-content:center;width:50px;height:50px;flex:0 0 auto;border-radius:var(--radius-md);background:linear-gradient(150deg,var(--blue-600),var(--blue-800));color:var(--white)"><Icone nome={ic} tam={24} /></span>
  <div>
  <h2 style="font-size:var(--fs-h4);margin:0 0 4px">{titulo}</h2>
  <p style="font-size:var(--fs-sm);color:var(--text-muted);margin:0;line-height:var(--lh-normal)">{txt}</p>
  </div>
  </div>
))}
</div>
</div>

<section id="servicos" style="background:var(--surface-subtle);padding-block:clamp(56px,8.5vw,92px)">
<div class="ds-container">
<div style="display:flex;flex-direction:column;gap:12px;align-items:center;text-align:center;max-width:680px;margin-inline:auto;margin-bottom:clamp(32px,5vw,48px)">
<span class="ds-eyebrow">Nossos serviços</span>
<h2 style="font-size:var(--fs-h2);margin:0;text-wrap:balance">Cuidamos de <span style="color:var(--color-primary)">todo o seu equipamento</span> de refrigeração</h2>
<p style="font-size:var(--fs-lg);color:var(--text-muted);margin:0;line-height:var(--lh-normal)">Atendemos clientes comerciais em toda a área de refrigeração — do bar ao restaurante, do mercado à indústria.</p>
</div>
<div class="cards-grid" style="display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:1fr;gap:22px">
{GRADE_HOME.map(([icone, titulo, txt, href, subs]) => (
  <div class="card-equip">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
  <span style="display:inline-flex;align-items:center;justify-content:center;width:60px;height:60px;border-radius:var(--radius-md);background:var(--blue-100)"><img src={icone} alt="" loading="lazy" decoding="async" width="48" height="48" style="width:48px;height:48px;object-fit:contain;display:block"></span>
  <span class="card-seta" style="display:inline-flex;color:var(--color-primary);opacity:0.5;margin-top:6px"><Icone nome="arrow-right" tam={18} /></span>
  </div>
  <h3 style="font-family:var(--font-display);font-weight:700;font-size:var(--fs-h4);margin:0"><a class="card-cobre" href={href} style="color:var(--text-strong)">{titulo}</a></h3>
  <p style="font-family:var(--font-body);font-size:var(--fs-base);color:var(--text-muted);margin:0;line-height:var(--lh-normal)">{txt}</p>
  {subs && (
    <p class="card-subs" style="margin:2px 0 0;font-family:var(--font-body);font-size:var(--fs-sm);color:var(--text-muted);line-height:1.7">
    {subs.map(([label, sh], i) => (
      <Fragment>{i > 0 && <span style="color:var(--border-subtle);padding:0 6px">·</span>}<a href={sh} style="color:var(--color-primary);font-weight:600">{label}</a></Fragment>
    ))}
    </p>
  )}
  </div>
))}
</div>
<div style="display:flex;justify-content:center;margin-top:40px">
<a href={zapOutro} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;background:var(--color-whatsapp);color:var(--white);font-family:var(--font-body);font-weight:700;font-size:var(--fs-base);padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="message-circle" tam={20} />Não achou seu equipamento? Fale conosco</a>
</div>
</div>
</section>

<section id="sobre" style="background:var(--surface-page);padding-block:clamp(56px,8.5vw,92px)">
<div class="ds-container">
<div class="split-grid" style="display:grid;grid-template-columns:0.9fr 1.1fr;gap:56px;align-items:start">
<div style="display:flex;flex-direction:column;gap:20px">
<span class="ds-eyebrow">Quem somos</span>
<h2 style="font-size:var(--fs-h2);margin:0;text-wrap:balance">Qualidade que gera confiança, <span style="color:var(--color-accent-strong)">confiança que gera parcerias</span></h2>
<div style="background:var(--color-cta);color:var(--ink);border-radius:var(--radius-lg);padding:20px 24px;box-shadow:var(--shadow-cta);max-width:240px">
<strong style="font-family:var(--font-display);font-weight:800;font-size:34px;display:block;line-height:1">12 anos</strong>
<span style="font-size:var(--fs-sm);font-weight:600">cuidando da refrigeração do seu negócio</span>
</div>
</div>
<div style="display:flex;flex-direction:column;gap:22px">
<p style="font-size:var(--fs-base);color:var(--text-muted);margin:0;line-height:var(--lh-relaxed)">Confiança não se conquista com promessas, mas com trabalho bem feito. Há 12 anos, a Santos Refrigeração constrói sua história com seriedade, transparência e compromisso em cada atendimento. É por isso que empresas de todo o Rio de Janeiro e Grande Rio depositam em nossa equipe a confiança de quem busca qualidade, responsabilidade e soluções executadas com excelência.</p>
<p style="font-size:var(--fs-base);color:var(--text-muted);margin:0;line-height:var(--lh-relaxed)">Cada serviço é realizado com atenção aos detalhes, diagnóstico preciso e total clareza em todas as etapas. Trabalhamos com honestidade, preço definido antes da execução e garantia em tudo o que fazemos, porque acreditamos que respeito ao cliente e qualidade não são diferenciais, mas princípios.</p>
<p style="font-size:var(--fs-base);color:var(--text-muted);margin:0;line-height:var(--lh-relaxed)">Mais do que prestar <a href="/tecnico-refrigeracao-comercial.html" style="color:inherit;text-decoration:underline;text-underline-offset:3px">assistência técnica em refrigeração comercial</a>, entregamos segurança, tranquilidade e a certeza de que existe uma equipe comprometida em fazer o trabalho da maneira certa. É assim que, ao longo dos anos, transformamos a confiança de nossos clientes em relacionamentos duradouros e construímos uma reputação que levamos com orgulho em cada serviço realizado.</p>
<div style="margin-top:10px">
<a href={zap} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;align-self:flex-start;background:var(--color-whatsapp);color:var(--white);font-family:var(--font-body);font-weight:700;font-size:var(--fs-base);padding:14px 24px;border-radius:var(--radius-md);text-decoration:none;width:fit-content"><Icone nome="message-circle" tam={20} />Solicitar atendimento</a>
</div>
</div>
</div>
</div>
</section>

<section id="area" style="background:var(--surface-section);padding-block:clamp(56px,8.5vw,92px)">
<div class="ds-container">
<div class="split-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center">
<div style="display:flex;flex-direction:column;gap:18px">
<span class="ds-eyebrow">Área de atendimento</span>
<h2 style="font-size:var(--fs-h2);margin:0;text-wrap:balance">Atendemos todo o Rio e Grande Rio</h2>
<p style="font-size:var(--fs-base);color:var(--text-muted);margin:0;line-height:var(--lh-relaxed)">Acesso fácil e rápido a diversos bairros. Confira algumas das regiões que atendemos — não viu a sua? Fale conosco.</p>
<div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:4px">
{AREAS.map((a) => (
  <span style="display:inline-flex;align-items:center;gap:6px;background:var(--white);border:1px solid var(--border-subtle);border-radius:var(--radius-pill);padding:7px 14px;font-family:var(--font-body);font-size:var(--fs-sm);font-weight:600;color:var(--text-body)"><Icone nome="map-pin" tam={14} cor="var(--color-primary)" /> {a}</span>
))}
</div>
</div>
<div style="border-radius:var(--radius-xl);overflow:hidden;box-shadow:var(--shadow-md);border:1px solid var(--border-subtle);aspect-ratio:4 / 3.2;background:var(--blue-100)">
<img src="/assets/opt-s1.webp" alt="Rio de Janeiro — área de atendimento da Santos Refrigeração" loading="lazy" decoding="async" width="800" height="640" style="width:100%;height:100%;object-fit:cover;display:block">
</div>
</div>
</div>
</section>

<section style="background:linear-gradient(135deg,var(--blue-900),var(--blue-700));padding-block:clamp(48px,7vw,64px)">
<div class="ds-container" style="display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap">
<div style="max-width:640px">
<h2 style="font-size:var(--fs-h2);color:var(--white);margin:0 0 8px;text-wrap:balance">Precisa de um técnico hoje?</h2>
<p style="font-size:var(--fs-lg);color:rgba(255,255,255,0.82);margin:0">Orçamento sem compromisso. Atendimento rápido no Rio e Grande Rio.</p>
</div>
<div style="display:flex;gap:12px;flex-wrap:wrap">
<a href={zap} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;background:var(--color-whatsapp);color:var(--white);font-family:var(--font-body);font-weight:700;padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="message-circle" tam={20} />Falar no WhatsApp</a>
<a href="/contato.html" style="display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.3);color:var(--white);font-family:var(--font-body);font-weight:700;padding:14px 24px;border-radius:var(--radius-md);text-decoration:none"><Icone nome="arrow-right" tam={18} />Página de contato</a>
</div>
</div>
</section>

</Base>
