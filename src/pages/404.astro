---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import conteudo from '../data/conteudo.json';
const servicos = Object.values(conteudo).filter((s) => !s.hideFromNav).slice(0, 8);
---
<Base titulo="Página não encontrada | Santos Refrigeração" descricao="A página que você procurava não existe. Veja os serviços de refrigeração comercial da Santos Refrigeração no Rio e Grande Rio." caminho="/404.html">
<section style="background:var(--surface-page);padding-block:clamp(56px,8.5vw,92px)">
<div class="ds-container" style="max-width:720px;display:flex;flex-direction:column;gap:20px;text-align:center;margin-inline:auto">
<span class="ds-eyebrow" style="align-self:center">Erro 404</span>
<h1 style="font-size:var(--fs-h1);margin:0;text-wrap:balance">Esta página não existe</h1>
<p style="font-size:var(--fs-lg);color:var(--text-muted);margin:0">O endereço pode ter mudado. Veja abaixo os serviços que atendemos, ou volte para a <a href="/">página inicial</a>.</p>
<div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:8px">
{servicos.map((s) => (
  <a href={'/' + s.slug + '.html'} style="display:inline-flex;align-items:center;gap:6px;background:var(--white);border:1px solid var(--border-subtle);border-radius:var(--radius-pill);padding:9px 16px;font-family:var(--font-body);font-size:var(--fs-sm);font-weight:600">{s.title} <Icone nome="arrow-right" tam={14} /></a>
))}
</div>
</div>
</section>
</Base>
